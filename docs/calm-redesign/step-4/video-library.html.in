<svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
<rect x="1" y="4" width="22" height="16" rx="4" fill="currentColor"/>
<path d="m10 8 7 4-7 4z" fill="#0c1b25"/>
</svg>
<span>Watch on YouTube</span>
</a>
</section>{{video_navigation}}
{{video_sections}}</main>
</div>{{footer}}</body>
